    {
      "parameters": {
        "jsCode": "// Re-parse fileName để lấy lại part1/part2/mins cho YouTube node\nconst re = /^([^_]+)_([^_]+)_(\\d+)mins(?:\\..*)?$/i;\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (!j.fileId || !j.fileName) continue;\n  const m = String(j.fileName).match(re);\n  if (!m) continue;\n  const [, part1Raw, part2Raw, minsRaw] = m;\n  const mins = Number(minsRaw);\n  if (!Number.isInteger(mins) || mins <= 0) continue;\n  out.push({\n    json: {\n      ...j,\n      part1: String(part1Raw).trim(),\n      part2: String(part2Raw).trim(),\n      mins\n    }\n  });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
