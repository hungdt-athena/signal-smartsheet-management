    {
      "parameters": {
        "jsCode": "// One item per genre the app says is live today. `targets` already excludes\n// genres that are switched off or have nobody available, so this flow no longer\n// decides anything -- it just carries out the list. `genres` holds the full\n// picture (enabled + available per genre) for the summary message.\nconst res = $('HTTP: Push Targets').first().json;\nconst targets = res.targets || [];\nif (targets.length === 0) return [];\nreturn targets.map(t => ({ json: { category_group: t } }));\n"
      },
      "id": "7a9fe990-9f5c-44cb-8e14-f678d134fa08",
      "name": "Split per category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        16
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://signal-playtest-management.replit.app/api/cron/push-evaluations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "dev-webhook-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ category: $json.category_group, dryRun: false }) }}",
        "options": {}
      },
      "id": "1ad11fef-3dec-4a81-873f-6da69299f652",
      "name": "HTTP: Push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1504,
        16
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://signal-playtest-management.replit.app/api/cron/assign-evaluators",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "dev-webhook-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ category: $('Split per category').item.json.category_group, dryRun: false }) }}",
        "options": {}
      },
      "id": "a42abc98-90d2-4402-9aae-ee6cf44bfd76",
      "name": "HTTP: Assign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1728,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate pushed/assigned/per_evaluator totals from all HTTP: Push + HTTP: Assign responses.\n// Runs once for ALL items (runOnceForAllItems mode) to produce a single roll-up item.\nconst pushItems = $('HTTP: Push').all();\nconst assignItems = $('HTTP: Assign').all();\n\nlet totalPushed = 0;\nlet totalAssigned = 0;\nconst perEvaluator = {};\nconst byCategory = {};\nlet hasError = false;\n\nfor (const item of pushItems) {\n  const j = item.json || {};\n  // Detect failure: missing ok:true or explicit error field\n  if (j.ok !== true || j.error) hasError = true;\n  totalPushed += (j.pushed || 0);\n  const cat = j.category || '?';\n  if (!byCategory[cat]) byCategory[cat] = { pushed: 0, assigned: 0 };\n  byCategory[cat].pushed += (j.pushed || 0);\n}\n\nfor (const item of assignItems) {\n  const j = item.json || {};\n  // Detect failure: missing ok:true or explicit error field\n  if (j.ok !== true || j.error) hasError = true;\n  totalAssigned += (j.assigned || 0);\n  const cat = j.category || '?';\n  if (!byCategory[cat]) byCategory[cat] = { pushed: 0, assigned: 0 };\n  byCategory[cat].assigned += (j.assigned || 0);\n  // per_evaluator map from each assign response\n  for (const [ev, count] of Object.entries(j.per_evaluator || {})) {\n    perEvaluator[ev] = (perEvaluator[ev] || 0) + count;\n  }\n}\n\n// A genre can be live in config yet have nobody available, or be switched off\n// entirely. Saying so beats a silent zero.\nconst gate = ($('HTTP: Push Targets').first().json.genres) || [];\nconst skipLines = gate.filter(g => !g.active)\n  .map(g => `  ${g.bucket}: ${g.enabled ? 'no one available' : 'off'}`)\n  .join('\\n');\n\nconst now = new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });\nconst catLines = Object.entries(byCategory)\n  .map(([c, v]) => `  ${c}: pushed=${v.pushed} assigned=${v.assigned}`)\n  .join('\\n');\nconst evLines = Object.entries(perEvaluator)\n  .map(([e, v]) => `  ${e}: ${v}`)\n  .join('\\n');\n\nconst note = `[${now}] db-push-assign\\nTotal pushed: ${totalPushed} | assigned: ${totalAssigned}\\nBy category:\\n${catLines || '  (none)'}\\nSkipped:\\n${skipLines || '  (none)'}\\nBy evaluator:\\n${evLines || '  (none)'}`;\n\nconst status = hasError ? 'error' : 'success';\nreturn [{ json: { name: 'db-push-assign', status, note } }];\n"
      },
      "id": "4e7b5dcf-892b-4ede-b355-1ee24253b2fb",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1952,
        16
      ]
    },
    {
      "parameters": {
        "spaceId": "spaces/AAQAYTKWM1I",
        "jsonParameters": true,
        "messageJson": "={{\n{\n  cardsV2: [\n    {\n      cardId: \"db-push-assign-\" + $now.toMillis(),\n      card: {\n        header: {\n          title: \"DB Push+Assign Run\",\n          subtitle: \"Status: \" + $json.status,\n          imageType: \"SQUARE\"\n        },\n        sections: [\n          {\n            widgets: [\n              {\n                textParagraph: {\n                  text: $json.note.replace(/\\n/g, '<br>')\n                }\n              }\n            ]\n          }\n        ]\n      }\n    }\n  ]\n}\n}}",
        "additionalFields": {}
      },
