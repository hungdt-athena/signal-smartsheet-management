    {
      "parameters": {
        "jsCode": "// Parse filename pattern và extract fields\nconst re = /^([^_]+)_([^_]+)_(\\d+)mins(?:\\..*)?$/i;\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const id = j.id || j.fileId;\n  let name = j.name || j.fileName;\n  if (!id || !name) continue;\n  name = String(name).trim();\n  const mimeType = j.mimeType || j.mime_type;\n  if (mimeType === 'application/vnd.google-apps.folder') continue;\n  const m = name.match(re);\n  if (!m) continue;\n  const [, part1Raw, part2Raw, minsRaw] = m;\n  const mins = Number(minsRaw);\n  if (!Number.isInteger(mins) || mins <= 0) continue;\n  const part1 = String(part1Raw).trim();\n  const part2 = String(part2Raw).trim();\n  out.push({\n    json: {\n      fileId: id,\n      fileName: name,\n      title: `${part1} ${part2} (${mins} mins)`,\n      part1,\n      part2,\n      mins\n    }\n  });\n}\nreturn out;"
      },
