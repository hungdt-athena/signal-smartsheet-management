+    c['Resolve Names'] = link('Rename Drive File')
+    c['Rename Drive File'] = link('Code Result')
+    c['Code Result'] = link('Log Code Result')
+    c['Code Notices'] = link('Log Code Notices', 'Chat Code Notice')
