+    }
+    nodes.append(rename)
+    nodes.append(code_node('Code Result', RESULT_JS, [x0 + 1792, y0 - 480]))
+
+    def log_node(name, pos):
+        n = copy.deepcopy(log_tpl)
+        n['id'] = nid(name)
+        n['name'] = name
+        n['position'] = pos
+        return n
+
+    nodes.append(log_node('Log Code Result', [x0 + 2016, y0 - 480]))
